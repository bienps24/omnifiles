# Railway variables (set them on BOTH services: web and worker)

# Postgres (Railway: add a PostgreSQL plugin, then reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:5432/railway

# @OmniFilesApp token from @BotFather
MAIN_BOT_TOKEN=123456:ABC...

# Long random secret used to encrypt bot tokens. Never change it after launch.
APP_KEY=change-me-to-a-long-random-string

# Public address of the web service
PUBLIC_URL=https://files.omnigate.info

# Your Telegram user id (admin)
ADMIN_ID=6166768969

# Channel people join before cloning, and the default ad (the bot must be an admin there to check members)
NEWS_CHANNEL=@omnigatework

# Private channel where the main bot keeps a copy of every file (bot must be an admin). Optional.
BACKUP_CHAT_ID=-1001234567890

# Contact admin button: your Telegram username without @ (empty = no Contact admin button)
CONTACT_USERNAME=

# Payments: @omnigatepaybot sends the Stars invoices and reports each payment to /pay.php
PAY_BOT=omnigatepaybot
# Long random secret; the SAME value goes in OMNIFILES_PAY_SECRET on the omnigatepaybot service
PAY_SECRET=change-me-to-another-long-random-string

# Prices in Telegram Stars (keep them the same as OMNIFILES_PRO_STARS / OMNIFILES_SLOT_STARS on omnigatepaybot)
PRO_PRICE_STARS=300
SLOT_PRICE_STARS=999

# Only on the worker service
ROLE=worker
